generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Plan {
  trial
  starter
  basic
  pro
  business
  enterprise
}

enum BusinessType {
  dentist
  aesthetic_clinic
  beauty_center
  hair_salon
  barbershop
  spa
  nail_studio
  massage
  tattoo_piercing
  hair_transplant
  other
}

enum AnamnesisQuestionType {
  short_text
  long_text
  yes_no
  single_choice
  multi_choice
  date
  number
}

enum CurrentAccountPartyType {
  customer
  supplier
}

enum CurrentAccountEntryRefType {
  manual
  opening_balance
  appointment
  invoice
  purchase_invoice
  payment
  refund
  adjustment
}

enum PurchaseInvoiceStatus {
  draft
  posted
  cancelled
}

enum UserRole {
  owner
  manager
  staff
  superadmin
}

enum CustomerSegment {
  vip
  regular
  sleeping
  at_risk
}

enum AppointmentStatus {
  pending
  confirmed
  in_progress
  completed
  cancelled
  no_show
}

enum BookingChannel {
  whatsapp
  telegram
  web
  manual
}

enum PaymentMethod {
  cash
  card
  mixed
  online
}

enum TransactionStatus {
  pending
  completed
  refunded
}

enum ResourceType {
  room
  chair
  device
}

enum NotificationChannel {
  whatsapp
  telegram
  sms
  push
  email
}

enum NotificationType {
  booking_confirm
  reminder_24h
  reminder_2h
  campaign
  waitlist
  cancellation
}

enum CommissionType {
  percentage
  fixed
}

enum LeaveType {
  day_off
  sick_leave
  vacation
  other
}

enum PackageStatus {
  active
  completed
  expired
  refunded
}

enum StockMovementType {
  in              // alım
  out             // satış/kullanım
  adjustment_in   // sayım fazla
  adjustment_out  // sayım eksik
  transfer_in
  transfer_out
  waste           // fire
  return          // iade
}

enum TipSource {
  cash
  card
  salon_pool
}

enum StaffPayoutStatus {
  pending
  paid
  cancelled
}

enum WaitlistStatus {
  waiting
  notified
  booked
  expired
  cancelled
}

enum ActivityAction {
  create
  update
  delete
  login
  logout
  pay
  refund
  cancel
  status_change
  message_send
}

// ─── Tenant (Salon / İşletme) ─────────────────────────────────────────────────

model Tenant {
  id                 String    @id @default(uuid()) @db.Uuid
  name               String
  slug               String    @unique
  plan               Plan         @default(basic)
  businessType       BusinessType @default(beauty_center)
  whatsappNumber     String?
  whatsappApiToken   String?
  telegramBotToken   String?
  settings              Json      @default("{}")
  isActive              Boolean   @default(true)
  onboardingCompleted   Boolean   @default(false)
  trialEndsAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  users              User[]
  staffProfiles               StaffProfile[]
  customers                   Customer[]
  services                    Service[]
  resources                   Resource[]
  appointments                Appointment[]
  transactions                Transaction[]
  expenses                    Expense[]
  inventory                   InventoryItem[]
  notificationLogs            NotificationLog[]
  staffServiceAssignments     StaffServiceAssignment[]
  staffLeaves                 StaffLeave[]
  botConversations            BotConversation[]
  servicePackages             ServicePackage[]
  customerPackages            CustomerPackage[]
  packageUsages               PackageUsage[]
  tipEntries                  TipEntry[]
  tipDistributions            TipDistribution[]
  customerPhotos              CustomerPhoto[]
  anamnesisQuestions          AnamnesisQuestion[]
  anamnesisAnswers            CustomerAnamnesisAnswer[]
  currentAccountEntries       CurrentAccountEntry[]
  purchaseInvoices            PurchaseInvoice[]
  staffPayouts                StaffPayout[]
  suppliers                   Supplier[]
  stockMovements              StockMovement[]
  serviceInventoryRecipes     ServiceInventoryRecipe[]
  waitlist                    Waitlist[]
  activityLogs                ActivityLog[]

  @@map("tenants")
}

// ─── User (Kullanıcı Hesabı) ──────────────────────────────────────────────────

model User {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String?   @db.Uuid
  email        String
  passwordHash String
  role         UserRole  @default(staff)
  fullName     String
  phone        String?
  avatarUrl    String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant              Tenant?               @relation(fields: [tenantId], references: [id])
  staffProfile        StaffProfile?
  passwordResetTokens PasswordResetToken[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

// ─── Staff Profile (Personel Profili) ────────────────────────────────────────

model StaffProfile {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @unique @db.Uuid
  tenantId             String    @db.Uuid
  title                String
  bio                  String?
  workingHours         Json      @default("{}")
  expertiseTags        String[]
  colorCode            Int?
  acceptsOnlineBooking Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user               User                     @relation(fields: [userId], references: [id])
  tenant             Tenant                   @relation(fields: [tenantId], references: [id])
  appointments       Appointment[]
  serviceAssignments StaffServiceAssignment[]
  leaves             StaffLeave[]

  @@index([tenantId])
  @@map("staff_profiles")
}

// ─── Customer (Müşteri) ───────────────────────────────────────────────────────

model Customer {
  id               String          @id @default(uuid()) @db.Uuid
  tenantId         String          @db.Uuid
  fullName         String
  phone            String
  email            String?
  birthDate        DateTime?       @db.Date
  allergyNotes     String?
  preferenceNotes  String?
  totalVisits      Int             @default(0)
  lifetimeValue    Decimal         @default(0) @db.Decimal(10, 2)
  segment          CustomerSegment @default(regular)
  lastVisitAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  appointments     Appointment[]
  notificationLogs NotificationLog[]
  packages         CustomerPackage[]
  photos           CustomerPhoto[]
  anamnesisAnswers CustomerAnamnesisAnswer[]
  waitlistEntries  Waitlist[]
  currentAccountEntries CurrentAccountEntry[]

  @@unique([tenantId, phone])
  @@index([tenantId])
  @@map("customers")
}

// ─── Service (Hizmet) ─────────────────────────────────────────────────────────

model Service {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @db.Uuid
  name             String
  category         String?
  durationMinutes  Int
  bufferMinutes    Int      @default(0)
  price            Decimal  @db.Decimal(10, 2)
  commissionRate   Decimal  @default(0) @db.Decimal(4, 4)
  requiresDeposit  Boolean  @default(false)
  depositAmount    Decimal? @db.Decimal(10, 2)
  isOnlineBookable Boolean  @default(true)
  isActive         Boolean  @default(true)
  followUpSchedule Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant           Tenant                   @relation(fields: [tenantId], references: [id])
  appointments     Appointment[]
  staffAssignments StaffServiceAssignment[]
  packages         ServicePackage[]
  inventoryRecipes ServiceInventoryRecipe[]

  @@index([tenantId])
  @@map("services")
}

// ─── Resource (Oda / Koltuk / Cihaz) ─────────────────────────────────────────

model Resource {
  id       String       @id @default(uuid()) @db.Uuid
  tenantId String       @db.Uuid
  name     String
  type     ResourceType
  isActive Boolean      @default(true)

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  appointments Appointment[]

  @@index([tenantId])
  @@map("resources")
}

// ─── Appointment (Randevu) ────────────────────────────────────────────────────

model Appointment {
  id                 String            @id @default(uuid()) @db.Uuid
  tenantId           String            @db.Uuid
  customerId         String            @db.Uuid
  staffId            String            @db.Uuid
  serviceId          String            @db.Uuid
  resourceId         String?           @db.Uuid
  referenceCode      String            @unique
  status             AppointmentStatus @default(pending)
  bookingChannel     BookingChannel    @default(manual)
  startAt            DateTime
  endAt              DateTime
  priceCharged       Decimal           @db.Decimal(10, 2)
  notes              String?
  cancellationReason String?
  cancelledById      String?           @db.Uuid
  isDeleted          Boolean           @default(false)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  tenant       Tenant            @relation(fields: [tenantId], references: [id])
  customer     Customer          @relation(fields: [customerId], references: [id])
  staff        StaffProfile      @relation(fields: [staffId], references: [id])
  service      Service           @relation(fields: [serviceId], references: [id])
  resource     Resource?         @relation(fields: [resourceId], references: [id])
  transactions Transaction[]
  notificationLogs NotificationLog[]

  @@index([tenantId])
  @@index([tenantId, startAt])
  @@index([customerId])
  @@index([staffId, startAt])
  @@map("appointments")
}

// ─── Transaction (Ödeme / Prim) ───────────────────────────────────────────────

model Transaction {
  id               String            @id @default(uuid()) @db.Uuid
  tenantId         String            @db.Uuid
  appointmentId    String?           @db.Uuid
  staffId          String?           @db.Uuid
  grossAmount      Decimal           @db.Decimal(10, 2)
  commissionAmount Decimal           @db.Decimal(10, 2)
  commissionRate   Decimal           @db.Decimal(4, 4)
  paymentMethod    PaymentMethod     @default(cash)
  cashAmount       Decimal           @default(0) @db.Decimal(10, 2)
  cardAmount       Decimal           @default(0) @db.Decimal(10, 2)
  depositDeducted  Decimal           @default(0) @db.Decimal(10, 2)
  status           TransactionStatus @default(pending)
  notes            String?
  completedAt      DateTime?
  createdAt        DateTime          @default(now())

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])

  @@index([tenantId])
  @@index([appointmentId])
  @@map("transactions")
}

// ─── Expense (Gider) ──────────────────────────────────────────────────────────

model Expense {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  title          String
  category       String
  amount         Decimal  @db.Decimal(10, 2)
  expenseDate    DateTime @db.Date
  receiptUrl     String?
  isRecurring    Boolean  @default(false)
  recurrenceRule String?
  createdAt      DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("expenses")
}

// ─── Inventory (Stok) ─────────────────────────────────────────────────────────

model InventoryItem {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @db.Uuid
  name              String
  sku               String?
  quantity          Int      @default(0)
  lowStockThreshold Int      @default(5)
  unitCost          Decimal  @db.Decimal(10, 2)
  sellingPrice      Decimal? @db.Decimal(10, 2)
  unit              String   @default("adet")
  updatedAt         DateTime @updatedAt

  tenant    Tenant                   @relation(fields: [tenantId], references: [id])
  movements StockMovement[]
  recipes   ServiceInventoryRecipe[]
  purchaseItems PurchaseInvoiceItem[]

  @@index([tenantId])
  @@map("inventory")
}

// ─── Notification Log ─────────────────────────────────────────────────────────

model NotificationLog {
  id            String              @id @default(uuid()) @db.Uuid
  tenantId      String              @db.Uuid
  customerId    String?             @db.Uuid
  appointmentId String?             @db.Uuid
  channel       NotificationChannel
  type          NotificationType
  status        String              @default("sent")
  createdAt     DateTime            @default(now())

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  customer    Customer?    @relation(fields: [customerId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])

  @@index([tenantId])
  @@index([appointmentId])
  @@map("notification_logs")
}

// ─── Staff Service Assignment (Personel-Hizmet Atama) ────────────────────────

model StaffServiceAssignment {
  id              String         @id @default(uuid()) @db.Uuid
  staffId         String         @db.Uuid
  serviceId       String         @db.Uuid
  tenantId        String         @db.Uuid
  commissionType  CommissionType @default(percentage)
  commissionValue Decimal        @default(0) @db.Decimal(10, 2)
  priceOverride   Decimal?       @db.Decimal(10, 2)
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())

  staff   StaffProfile @relation(fields: [staffId], references: [id])
  service Service      @relation(fields: [serviceId], references: [id])
  tenant  Tenant       @relation(fields: [tenantId], references: [id])

  @@unique([staffId, serviceId])
  @@index([staffId])
  @@index([serviceId])
  @@index([tenantId])
  @@map("staff_service_assignments")
}

// ─── Staff Leave (Personel İzin) ─────────────────────────────────────────────

model StaffLeave {
  id        String    @id @default(uuid()) @db.Uuid
  staffId   String    @db.Uuid
  tenantId  String    @db.Uuid
  leaveDate DateTime  @db.Date
  leaveType LeaveType @default(day_off)
  note      String?
  createdAt DateTime  @default(now())

  staff  StaffProfile @relation(fields: [staffId], references: [id])
  tenant Tenant       @relation(fields: [tenantId], references: [id])

  @@index([staffId])
  @@index([tenantId, leaveDate])
  @@map("staff_leaves")
}

// ─── Password Reset Token ─────────────────────────────────────────────────────

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  token     String    @unique
  userId    String    @db.Uuid
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model BotSession {
  id          String   @id  // "tenantId:channelType:from"
  tenantId    String   @db.Uuid
  channelType String
  fromRef     String
  data        Json
  expiresAt   DateTime
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@index([expiresAt])
  @@map("bot_sessions")
}

model BotConversation {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  channel      String   // "telegram" | "whatsapp"
  customerRef  String   // telefon numarası veya chat ID
  messages     Json     // Array<{ role, content, ts }>
  outcome      String   // "booked" | "cancelled" | "handoff" | "abandoned"
  referenceCode String? // randevu oluşturulduysa RDV-xxx
  turnCount    Int      @default(0)
  startedAt    DateTime
  endedAt      DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, endedAt(sort: Desc)])
  @@map("bot_conversations")
}

// ═══════════════════════════════════════════════════════════════════════════════
// PAKET SİSTEMİ (Service Packages)
// ═══════════════════════════════════════════════════════════════════════════════

model ServicePackage {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  serviceId       String   @db.Uuid
  name            String                          // "Cilt Bakım Paketi 6 Seans"
  totalSessions   Int                             // 6
  price           Decimal  @db.Decimal(10, 2)     // 1800 TL (1 seans 350 → 6'sı 2100, paket 1800)
  validityDays    Int?                            // 180 (paket 6 ay geçerli, null = sınırsız)
  description     String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  service           Service           @relation(fields: [serviceId], references: [id])
  customerPackages  CustomerPackage[]

  @@index([tenantId])
  @@index([serviceId])
  @@map("service_packages")
}

model CustomerPackage {
  id                  String        @id @default(uuid()) @db.Uuid
  tenantId            String        @db.Uuid
  customerId          String        @db.Uuid
  packageId           String        @db.Uuid
  totalSessions       Int                                       // satın alındığında snapshot
  remainingSessions   Int                                       // mevcut kalan
  pricePaid           Decimal       @db.Decimal(10, 2)
  status              PackageStatus @default(active)
  purchaseDate        DateTime      @default(now())
  expiresAt           DateTime?
  completedAt         DateTime?
  notes               String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer       @relation(fields: [customerId], references: [id])
  package  ServicePackage @relation(fields: [packageId], references: [id])
  usages   PackageUsage[]

  @@index([tenantId])
  @@index([customerId, status])
  @@index([expiresAt])
  @@map("customer_packages")
}

model PackageUsage {
  id                  String   @id @default(uuid()) @db.Uuid
  customerPackageId   String   @db.Uuid
  appointmentId       String?  @db.Uuid                         // randevu üzerinden kullanıldıysa
  tenantId            String   @db.Uuid
  usedAt              DateTime @default(now())
  notes               String?

  customerPackage CustomerPackage @relation(fields: [customerPackageId], references: [id], onDelete: Cascade)
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([customerPackageId])
  @@index([tenantId])
  @@index([appointmentId])
  @@map("package_usages")
}

// ═══════════════════════════════════════════════════════════════════════════════
// BAHŞİŞ (Tips)
// ═══════════════════════════════════════════════════════════════════════════════

model TipEntry {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @db.Uuid
  appointmentId   String?   @db.Uuid                            // randevuya bağlı bahşiş
  staffId         String?   @db.Uuid                            // direkt personele kim
  amount          Decimal   @db.Decimal(10, 2)
  source          TipSource @default(cash)
  notes           String?
  collectedAt     DateTime  @default(now())
  isDistributed   Boolean   @default(false)                     // havuza atıldıysa true

  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  distributions  TipDistribution[]

  @@index([tenantId])
  @@index([staffId])
  @@index([appointmentId])
  @@map("tip_entries")
}

model TipDistribution {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  tipEntryId  String?  @db.Uuid                                 // tek bahşiş paylaşılırsa
  staffId     String   @db.Uuid                                 // alan personel
  amount      Decimal  @db.Decimal(10, 2)
  shareWeight Decimal? @db.Decimal(5, 2)                        // 1.0 = eşit pay, 1.5 = 1.5x
  notes       String?
  distributedAt DateTime @default(now())

  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tipEntry TipEntry?  @relation(fields: [tipEntryId], references: [id])

  @@index([tenantId])
  @@index([staffId])
  @@map("tip_distributions")
}

// ═══════════════════════════════════════════════════════════════════════════════
// MÜŞTERİ ZENGİNLEŞTİRME (Customer Enrichment)
// ═══════════════════════════════════════════════════════════════════════════════

model CustomerPhoto {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  customerId  String   @db.Uuid
  url         String                                            // S3/Vercel Blob URL
  caption     String?                                           // "Öncesi", "Sonrası", boyama vb.
  category    String?                                           // "saç_oncesi", "saç_sonrası", "tırnak" vs
  takenAt     DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([customerId, takenAt(sort: Desc)])
  @@map("customer_photos")
}

// ═══════════════════════════════════════════════════════════════════════════════
// ANAMNEZ / MÜŞTERİ HAKKINDA (Per-tenant dynamic questionnaire)
// ═══════════════════════════════════════════════════════════════════════════════

model AnamnesisQuestion {
  id          String                @id @default(uuid()) @db.Uuid
  tenantId    String                @db.Uuid
  label       String                                                          // "Kalp rahatsızlığınız var mı?"
  type        AnamnesisQuestionType
  options     Json?                                                           // ["Var", "Yok"] vb. choice tipleri için
  helperText  String?                                                         // Açıklama / ipucu
  isRequired  Boolean               @default(false)
  isCustom    Boolean               @default(true)                            // false: seed edilen default
  order       Int                   @default(0)
  isActive    Boolean               @default(true)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  tenant  Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  answers CustomerAnamnesisAnswer[]

  @@index([tenantId, order])
  @@map("anamnesis_questions")
}

model CustomerAnamnesisAnswer {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  customerId String   @db.Uuid
  questionId String   @db.Uuid
  value      Json                                                              // tipine göre string|bool|string[]|number
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  question AnamnesisQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([customerId, questionId])
  @@index([tenantId])
  @@index([customerId])
  @@map("customer_anamnesis_answers")
}

// ═══════════════════════════════════════════════════════════════════════════════
// PERSONEL MUHASEBESİ (Staff Payouts)
// ═══════════════════════════════════════════════════════════════════════════════

model StaffPayout {
  id            String            @id @default(uuid()) @db.Uuid
  tenantId      String            @db.Uuid
  staffId       String            @db.Uuid
  periodStart   DateTime          @db.Date
  periodEnd     DateTime          @db.Date
  grossEarned   Decimal           @db.Decimal(10, 2)            // dönemde hak ettiği komisyon toplamı
  bonus         Decimal           @default(0) @db.Decimal(10, 2)
  deductions    Decimal           @default(0) @db.Decimal(10, 2)
  netAmount     Decimal           @db.Decimal(10, 2)            // ödenen
  paymentMethod PaymentMethod     @default(cash)
  status        StaffPayoutStatus @default(pending)
  notes         String?
  paidAt        DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([staffId, periodEnd(sort: Desc)])
  @@map("staff_payouts")
}

// ═══════════════════════════════════════════════════════════════════════════════
// STOK HAREKETLERİ + HİZMET-MALZEME EŞLEŞMESİ (Stock Movements & Recipes)
// ═══════════════════════════════════════════════════════════════════════════════

model Supplier {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  name        String
  phone       String?
  email       String?
  notes       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  movements  StockMovement[]
  currentAccountEntries CurrentAccountEntry[]
  purchaseInvoices PurchaseInvoice[]

  @@index([tenantId])
  @@map("suppliers")
}

// ═══════════════════════════════════════════════════════════════════════════════
// CARİ HESAP (Current Account) — Müşteri & Tedarikçi açık hesap takibi
// ═══════════════════════════════════════════════════════════════════════════════

model CurrentAccountEntry {
  id            String                      @id @default(uuid()) @db.Uuid
  tenantId      String                      @db.Uuid
  partyType     CurrentAccountPartyType
  customerId    String?                     @db.Uuid
  supplierId    String?                     @db.Uuid
  date          DateTime                    @default(now())
  debit         Decimal                     @default(0) @db.Decimal(12, 2)   // Borç
  credit        Decimal                     @default(0) @db.Decimal(12, 2)   // Alacak
  description   String
  referenceType CurrentAccountEntryRefType  @default(manual)
  referenceId   String?                     @db.Uuid
  createdBy     String?                     @db.Uuid                          // userId
  createdAt     DateTime                    @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([tenantId, partyType])
  @@index([customerId, date(sort: Desc)])
  @@index([supplierId, date(sort: Desc)])
  @@map("current_account_entries")
}

model StockMovement {
  id           String            @id @default(uuid()) @db.Uuid
  tenantId     String            @db.Uuid
  inventoryId  String            @db.Uuid
  type         StockMovementType
  quantity     Int                                              // pozitif sayı, type yön belirler
  unitCost     Decimal?          @db.Decimal(10, 2)
  totalCost    Decimal?          @db.Decimal(10, 2)
  supplierId   String?           @db.Uuid
  appointmentId String?          @db.Uuid                        // kullanım randevuya bağlıysa
  notes        String?
  performedBy  String?           @db.Uuid                        // userId
  occurredAt   DateTime          @default(now())

  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inventory   InventoryItem  @relation(fields: [inventoryId], references: [id])
  supplier    Supplier?      @relation(fields: [supplierId], references: [id])

  @@index([tenantId])
  @@index([inventoryId, occurredAt(sort: Desc)])
  @@index([appointmentId])
  @@map("stock_movements")
}

model ServiceInventoryRecipe {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  serviceId      String   @db.Uuid
  inventoryId    String   @db.Uuid
  quantityPerUse Decimal  @db.Decimal(10, 3)                    // hizmet başına kullanılan miktar (0.080 = 80ml)
  notes          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  service   Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  inventory InventoryItem @relation(fields: [inventoryId], references: [id])

  @@unique([serviceId, inventoryId])
  @@index([tenantId])
  @@map("service_inventory_recipes")
}

// ═══════════════════════════════════════════════════════════════════════════════
// BEKLEME LİSTESİ (Waitlist)
// ═══════════════════════════════════════════════════════════════════════════════

model Waitlist {
  id            String          @id @default(uuid()) @db.Uuid
  tenantId      String          @db.Uuid
  customerId    String          @db.Uuid
  serviceId     String?         @db.Uuid                        // istediği hizmet
  staffId       String?         @db.Uuid                        // tercih edilen personel (opsiyonel)
  preferredDate DateTime?       @db.Date                         // istediği gün
  preferredTimeRange String?                                    // "10:00-14:00" gibi serbest
  status        WaitlistStatus  @default(waiting)
  notes         String?
  notifiedAt    DateTime?                                       // slot çıktı bildirildi
  bookedAppointmentId String?  @db.Uuid                          // sonra rezervasyon yapıldıysa
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([preferredDate])
  @@map("waitlist")
}

// ═══════════════════════════════════════════════════════════════════════════════
// AKTİVİTE GÜNLÜĞÜ (Audit Log)
// ═══════════════════════════════════════════════════════════════════════════════

model ActivityLog {
  id          String         @id @default(uuid()) @db.Uuid
  tenantId    String         @db.Uuid
  userId      String?        @db.Uuid                            // null = sistem
  action      ActivityAction
  entityType  String                                              // "Appointment", "Customer", "Service"
  entityId    String?
  description String                                              // human-readable
  metadata    Json?                                               // ek detay (eski değer, yeni değer)
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime       @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@map("activity_logs")
}

// ═══════════════════════════════════════════════════════════════════════════════
// ALIŞ FATURASI (Purchase Invoice) — Tedarikçi alımları + otomatik stok + cari
// ═══════════════════════════════════════════════════════════════════════════════

model PurchaseInvoice {
  id            String                @id @default(uuid()) @db.Uuid
  tenantId      String                @db.Uuid
  supplierId    String                @db.Uuid
  invoiceNumber String?                                                          // tedarikçinin verdiği fatura no
  invoiceDate   DateTime              @db.Date
  dueDate       DateTime?             @db.Date
  status        PurchaseInvoiceStatus @default(draft)
  subtotal      Decimal               @db.Decimal(12, 2)                         // KDV hariç ara toplam
  taxTotal      Decimal               @default(0) @db.Decimal(12, 2)
  discountTotal Decimal               @default(0) @db.Decimal(12, 2)
  total         Decimal               @db.Decimal(12, 2)                         // ödenecek toplam
  notes         String?
  postedAt      DateTime?                                                         // muhasebeleştiği zaman
  createdBy     String?               @db.Uuid
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  tenant   Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier Supplier              @relation(fields: [supplierId], references: [id])
  items    PurchaseInvoiceItem[]

  @@index([tenantId, invoiceDate(sort: Desc)])
  @@index([supplierId])
  @@map("purchase_invoices")
}

model PurchaseInvoiceItem {
  id          String   @id @default(uuid()) @db.Uuid
  invoiceId   String   @db.Uuid
  inventoryId String?  @db.Uuid                                                  // bağlanırsa stok girişi otomatik
  name        String                                                              // ürün adı (snapshot)
  quantity    Int
  unitPrice   Decimal  @db.Decimal(12, 2)
  taxRate     Decimal  @default(0) @db.Decimal(5, 2)                              // % KDV
  discount    Decimal  @default(0) @db.Decimal(12, 2)
  total       Decimal  @db.Decimal(12, 2)                                         // (quantity*unitPrice - discount) + KDV
  createdAt   DateTime @default(now())

  invoice   PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  inventory InventoryItem?  @relation(fields: [inventoryId], references: [id])

  @@index([invoiceId])
  @@map("purchase_invoice_items")
}
