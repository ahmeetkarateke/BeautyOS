# E2E koşucusu (geçici). Playwright imajının sürümü, web paketindeki @playwright/test ile aynı olmalı.
FROM mcr.microsoft.com/playwright:v1.64.1-noble
WORKDIR /e2e
ENV HOME=/tmp
RUN npm init -y >/dev/null \
    && npm install --no-audit --no-fund @playwright/test@1.64.1 @axe-core/playwright@4.14.0
COPY apps/web/playwright.config.ts ./playwright.config.ts
COPY apps/web/e2e ./e2e
