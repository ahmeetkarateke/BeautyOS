# BeautyOS — sunucu ortam değişkenleri (yalnız ADLAR; değerleri kurucu doldurur)
#
# Sunucuda /srv/beautyos altında şu dosyalar vardır: .env (canlı), .env.staging (staging; AYNI adlar, staging değerleri,
# ayrı JWT_SECRET, REDIS_URL sonu /1, PUBLIC_URL https://yeni-api.beautyossapp.com), .env.db, .env.migrate,
# .env.migrate-staging, .env.redis, .env.supabase. Her bölüm başlığı hangi dosyaya yazılacağını söyler.
# Dosyalar chmod 600 olur, git'e girmez; ajanlar okumaz/yazmaz.
# Yerel geliştirme için apps/api/.env.example geçerlidir (eski düzen; G18'de buraya taşınacak).
# Ayrıntı: docs/tasima-plani.md §4.

# =============================================================================
# UYGULAMA (.env)  ->  api ve requeue servisleri
# =============================================================================

# --- Compose değişkenleri (docker compose bunları proje dizinindeki .env'den okur; gizli değildir) ---
# Yayınlanan sürüm etiketi (ör. git sha-12). Web imajı ${BEAUTYOS_VERSION}-prod / -staging, api imajı ${BEAUTYOS_VERSION}
BEAUTYOS_VERSION=
# Staging'in sürüm etiketi (api-staging, migrate-staging, web-staging -> <sürüm>-staging). ZORUNLU ve ayrı:
# boşsa compose hata verip durur (${...:?}). Canlı sürüme kendiliğinden düşmez; denetim bulgusu, beautyos-tasima-1.
# Geliştirme önce staging'e çıktığı için çoğu zaman canlıdan ileridedir.
BEAUTYOS_STAGING_VERSION=
# İmaj kayıt defteri öneki, sonunda / ile (ör. ghcr.io/ahmeetkarateke/)
IMAGE_PREFIX=
# Yalnız yerel test: proxy ağının adı (sunucuda sirket-proxy). Yerel derleme için ayrıca
# NEXT_PUBLIC_API_URL_PROD ve NEXT_PUBLIC_API_URL_STAGING (yalnız deploy/compose.build.yml; sunucuda kullanılmaz)
PROXY_NETWORK=

# Çalışma ortamı. Sunucuda her zaman production.
NODE_ENV=production
# API dinleme portu (konteyner içi; dışarı yayınlanmaz)
PORT=3001
# Log seviyesi: info | warn | error | debug
LOG_LEVEL=info
# Konteyner saati. UTC KALMALI: gece no-show cron'u bu varsayımla yazıldı (ADR-0006)
TZ=UTC

# PostgreSQL, uygulama rolü (app_user; süper kullanıcı DEĞİL). Biçim: postgresql://app_user:<parola>@postgres:5432/beautyos
DATABASE_URL=
# Prisma şeması bu adı istiyor; DATABASE_URL ile AYNI değer (app_user). Migration rolü buraya YAZILMAZ.
DIRECT_URL=
# Redis (iç ağ, TLS yok, parolalı). Canlı: redis://:<REDIS_PASSWORD>@redis:6379/0 · Staging: .../1
REDIS_URL=

# JWT imzalama anahtarı, en az 32 karakter (openssl rand -hex 32). Taşımada yenisi önerilir.
JWT_SECRET=
# CORS izinli kaynaklar, virgülle. Canlı: https://beautyossapp.com,https://app.beautyossapp.com,https://www.beautyossapp.com
ALLOWED_ORIGINS=
# Eski ad (yalnız app.ts okuyor; G4'te birleşir). Boş bırakılabilir.
CORS_ORIGIN=
# API'nin dışa açık adresi; Telegram/WhatsApp webhook'u buna kaydedilir. Canlı: https://api.beautyossapp.com
PUBLIC_URL=
# Web uygulamasının adresi (şifre sıfırlama bağlantısı). Canlı: https://app.beautyossapp.com
FRONTEND_URL=

# --- Dış servisler. NETGSM_* canlıda ve staging'de BOŞ (SMS kapalı, kurucu kararı 2026-10-27).
# --- Telegram canlıda boş; test botu yalnız .env.staging'de. Sentry, G5-K5 birleşene kadar boş (KVKK).
# Telegram BotFather token'ı. Boşsa bot ve webhook kapalı.
TELEGRAM_BOT_TOKEN=
# Telegram webhook doğrulama gizli değeri (openssl rand -hex 16)
TELEGRAM_SECRET_TOKEN=
# Tek kiracılı bot kurulumu için sabit kiracı kimliği (çoğunlukla boş)
TELEGRAM_TENANT_ID=
# WhatsApp (360dialog). Boşsa kanal kapalı.
WHATSAPP_360DIALOG_API_KEY=
# true ise 360dialog sandbox kullanılır
WHATSAPP_SANDBOX=
# WhatsApp webhook imza gizli değeri
WHATSAPP_APP_SECRET=
# Meta webhook doğrulama token'ı
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Google Gemini API anahtarı (bot niyet çözümleme)
GEMINI_API_KEY=
# NetGSM kullanıcı kodu. Boşsa Mock SMS sağlayıcısı kullanılır (gerçek SMS gitmez).
NETGSM_USERCODE=
# NetGSM API şifresi
NETGSM_PASSWORD=
# NetGSM onaylı gönderici başlığı (varsayılan BEAUTYOS)
NETGSM_HEADER=
# SMS parça başı maliyet (TL), raporlama için; varsayılan 0.06
SMS_COST_PER_PART=
# Resend API anahtarı (şifre sıfırlama, hoş geldin e-postası). Boşsa e-posta gitmez.
RESEND_API_KEY=

# Cloudflare Turnstile gizli anahtarı. Üretimde boşsa herkese açık randevu REDDEDİLİR.
TURNSTILE_SECRET_KEY=
# Sentry DSN (boşsa Sentry kapalı)
SENTRY_DSN=
# Superadmin tohumlama uç noktasının gizli değeri
ADMIN_SEED_SECRET=

# =============================================================================
# WEB DERLEME DEĞERLERİ  ->  .env DOSYASINA DEĞİL, GitHub repository variables'a
# (gizli değil; derlemede imaja gömülür. Değişirse web imajı yeniden derlenir)
# =============================================================================
# Canlı: https://api.beautyossapp.com · Staging (ayrı değişken, ör. STAGING_NEXT_PUBLIC_API_URL): https://yeni-api.beautyossapp.com
# NEXT_PUBLIC_API_URL=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# NEXT_PUBLIC_BOT_FEATURES_ENABLED=

# =============================================================================
# VERİTABANI (.env.db)  ->  yalnız postgres servisi
# =============================================================================
# Süper kullanıcı; yalnız ilk kurulumda rolleri oluşturmak için. Uygulama BU kullanıcıyla bağlanmaz.
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# İlk açılışta oluşturulacak veritabanı adı (beautyos)
# POSTGRES_DB=
# Tablo sahibi + migration rolü (app_owner) parolası
# APP_OWNER_PASSWORD=
# Uygulama rolü (app_user) parolası; DATABASE_URL'deki parola ile aynı
# APP_USER_PASSWORD=
# Staging veritabanı (beautyos_staging) sahip rolü (stg_owner) ve uygulama rolü (stg_user) parolaları
# STG_OWNER_PASSWORD=
# STG_USER_PASSWORD=

# =============================================================================
# MIGRATION (.env.migrate)  ->  yalnız "migrate" servisi (profiles: [migrate])
# =============================================================================
# app_owner bağlantısı. ASLA .env'e yazılmaz. Biçim: postgresql://app_owner:<parola>@postgres:5432/beautyos
# MIGRATION_DATABASE_URL=
# Staging için aynı ad .env.migrate-staging dosyasında: postgresql://stg_owner:<parola>@postgres:5432/beautyos_staging

# =============================================================================
# REDIS (.env.redis)  ->  yalnız redis servisi
# =============================================================================
# Redis parolası; aynı değer .env içindeki REDIS_URL'de de geçer
# REDIS_PASSWORD=

# =============================================================================
# KAYNAK VERİTABANI (.env.supabase)  ->  yalnız betikler/veri-aktar.sh (taşıma bitince silinir)
# libpq değişkenleri; bağlantı bilgisi komut satırına girmesin diye URL yerine ayrı ayrı.
# Supabase "Session pooler" (IPv4, port 5432) bilgileri; Transaction pooler (6543) KULLANILMAZ.
# =============================================================================
# PGHOST=
# PGPORT=
# PGUSER=
# PGPASSWORD=
# PGDATABASE=
# require
# PGSSLMODE=
