# BeautyOS sunucu ortam değişkenleri. Gerçek değerleri KURUCU doldurur; bu dosya yalnız adları ve açıklamaları içerir.
# Altı ayrı dosya olarak /srv/beautyos klasöründe tutulur (git'e girmez, izin 600):
#   .env  .env.staging  .env.db  .env.redis  .env.migrate  .env.migrate-staging
# Bölüm başlıkları hangi değişkenin hangi dosyaya yazılacağını gösterir.
# Parolalarda $ ve boşluk kullanma (compose ve bağlantı dizgisi bozulur); openssl rand -hex 24 yeterlidir.

# =====================================================================================
# .env  —  COMPOSE DEĞİŞKENLERİ (gizli değil)
# =====================================================================================
# SÜRÜM DEĞİŞKENLERİ ARTIK surum.conf DOSYASINDADIR (gizli değil; yayinla.sh yönetir, deploy/README.md "Yayın").
# Aşağıdaki üç satır yalnız geçiş içindir: surum.conf sonra okunduğu için bunları ezer. Geçişten sonra üç satır silinebilir
# (silinirse elle `docker compose up` sürüm tanımsız diye durur; bu güvenli başarısızlıktır, yayın için yayinla.sh kullanılır).
# Çalıştırılacak imaj etiketi (git sha-12). Web için -prod / -staging eki compose'da eklenir.
BEAUTYOS_VERSION=
# Staging imaj etiketi (git sha-12), canlıdan BAĞIMSIZ. İkisi de zorunlu: staging sürümü değişince canlı etiketi etkilenmez.
BEAUTYOS_STAGING_VERSION=
# Canlının bir önceki sürümü (geri alma güvencesi). Yeni canlı sürüme geçerken BEAUTYOS_VERSION'ın eski değeri buraya yazılır;
# imaj-temizle.sh bu sürümün imajını ve kaynak paketini silmez.
BEAUTYOS_PREVIOUS_VERSION=
# İmaj kayıt defteri öneki, sonda eğik çizgiyle. Örn: ghcr.io/ahmeetkarateke/  (yerel derlemede boş)
IMAGE_PREFIX=
# Yalnız yerel derleme (compose.build.yml): web'e gömülen adresler. Örn: https://api.beautyossapp.com
# Sunucudaki üretim değerleri bu dosyadan DEĞİL, deploy/derleme.conf'tan gelir (Turnstile SITE anahtarı dahil). Gizli anahtar o dosyaya yazılmaz.
NEXT_PUBLIC_API_URL_PROD=
NEXT_PUBLIC_API_URL_STAGING=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_BOT_FEATURES_ENABLED=false
# (İsteğe bağlı, yalnız yerel test) Ortak proxy ağının adı. Varsayılan: sirket-proxy
# PROXY_NETWORK=sirket-proxy

# =====================================================================================
# .env (canlı api)  ve  .env.staging (api-staging)  —  API ÇALIŞMA ANI
# İki dosya aynı adları taşır; değerleri farklıdır (özellikle JWT_SECRET, veritabanı, Redis DB).
# =====================================================================================
LOG_LEVEL=info
# API'nin dışarıdan görünen adresi; Telegram webhook'u buraya kaydedilir.
#   canlı: https://api.beautyossapp.com      staging: https://yeni-api.beautyossapp.com
# GÜVENLİ KİP (kuru prova): boş bırak, yoksa canlı bot webhook'u çalınır.
PUBLIC_URL=
# Şifre sıfırlama bağlantısının web adresi. canlı: https://app.beautyossapp.com   staging: https://yeni.beautyossapp.com
FRONTEND_URL=
# Üretimde zorunlu (yoksa API başlamaz). Virgülle ayrılmış tam adresler.
#   canlı: https://beautyossapp.com,https://app.beautyossapp.com,https://www.beautyossapp.com
#   staging: https://yeni.beautyossapp.com
ALLOWED_ORIGINS=
# Uygulama rolüyle bağlantı (app_user / stg_user, sahip DEĞİL). Sunucu adı: postgres
#   canlı:   postgresql://app_user:PAROLA@postgres:5432/beautyos
#   staging: postgresql://stg_user:PAROLA@postgres:5432/beautyos_staging
DATABASE_URL=
# Prisma şeması çalışma anında da ister; DATABASE_URL ile AYNI değer (havuz yok, doğrudan bağlantı yok).
DIRECT_URL=
# Redis bağlantısı; parola .env.redis'tekiyle aynı. Canlı DB 0, staging DB 1.
#   canlı: redis://:PAROLA@redis:6379/0      staging: redis://:PAROLA@redis:6379/1
REDIS_URL=
# En az 32 karakter, canlı ve staging için AYRI. Üretim: openssl rand -hex 32
JWT_SECRET=
# Superadmin tohumlama gizli anahtarı
ADMIN_SEED_SECRET=
# Cloudflare Turnstile gizli anahtarı (üretimde yoksa herkese açık randevu reddedilir)
TURNSTILE_SECRET_KEY=
# Hata takibi (isteğe bağlı). Test ortamında ve geçişte BOŞ bırak: Sentry yurt dışıdır; olaylardan gövde, sorgu, çerez ve kullanıcı alanları silinse de (KVKK) DSN ancak hukuk-uyum onayıyla açılır.
SENTRY_DSN=
# E-posta (Resend). GÜVENLİ KİP: boş
RESEND_API_KEY=
# Telegram botu. Canlıda boş; test botu staging'dedir.
TELEGRAM_BOT_TOKEN=
TELEGRAM_SECRET_TOKEN=
TELEGRAM_TENANT_ID=
# Gemini (bot niyet çözümleme). GÜVENLİ KİP: boş
GEMINI_API_KEY=
# SMS (NetGSM). SMS kapalı: boş (sahte sağlayıcı kullanılır)
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_HEADER=
SMS_COST_PER_PART=
# WhatsApp (360dialog). Kullanılmıyorsa boş
WHATSAPP_360DIALOG_API_KEY=
WHATSAPP_SANDBOX=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# =====================================================================================
# VERİTABANI (.env.db dosyasına) — yalnız postgres servisi okur
# =====================================================================================
# Süper kullanıcı; uygulama bununla ASLA bağlanmaz. POSTGRES_DB canlı veritabanı adıdır ve 'beautyos' olmalı.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=beautyos
# Roller yalnız ilk açılışta (boş veri dizini) 01-roller.sh ile oluşturulur. Dört parola birbirinden farklı olmalı.
APP_OWNER_PASSWORD=
APP_USER_PASSWORD=
STG_OWNER_PASSWORD=
STG_USER_PASSWORD=

# =====================================================================================
# REDIS (.env.redis dosyasına) — yalnız redis servisi okur
# =====================================================================================
REDIS_PASSWORD=

# =====================================================================================
# MIGRATION (.env.migrate ve .env.migrate-staging dosyalarına) — yalnız migrate servisleri okur;
# api'nin .env / .env.staging dosyalarına YAZILMAZ
# =====================================================================================
# Sahip rolünün bağlantısı.
#   .env.migrate:         postgresql://app_owner:PAROLA@postgres:5432/beautyos
#   .env.migrate-staging: postgresql://stg_owner:PAROLA@postgres:5432/beautyos_staging
MIGRATION_DATABASE_URL=
