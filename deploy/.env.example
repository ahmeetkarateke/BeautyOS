# BeautyOS sunucu ortam değişkenleri. Gerçek değerleri KURUCU doldurur; bu dosya yalnız adları ve açıklamaları içerir.
# Dört ayrı dosya olarak /srv/beautyos klasöründe tutulur (git'e girmez):
#   .env, .env.db, .env.redis, .env.migrate
# Bölüm başlıkları hangi değişkenin hangi dosyaya yazılacağını gösterir.

# =====================================================================================
# .env  —  COMPOSE DEĞİŞKENLERİ (gizli değil)
# =====================================================================================
# Derlenen imaj etiketi (örn. 2026.10.27-1). Geri alma için eski etiket silinmez.
BEAUTYOS_VERSION=
# Web derlemesine gömülür (gizli DEĞİL). Örn: https://api.beautyossapp.com
NEXT_PUBLIC_API_URL=
# Cloudflare Turnstile site anahtarı (herkese açık). Boşsa randevu formunda CAPTCHA çıkmaz.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Bot ekranlarını göster: true | false
NEXT_PUBLIC_BOT_FEATURES_ENABLED=false
# (İsteğe bağlı) Ortak proxy ağının adı. Varsayılan: sirket-proxy
# PROXY_NETWORK=sirket-proxy

# =====================================================================================
# .env  —  API ÇALIŞMA ANI
# =====================================================================================
LOG_LEVEL=info
# API'nin dışarıdan görünen adresi; Telegram/WhatsApp webhook'u bu adrese kaydedilir. Örn: https://api.beautyossapp.com
# GÜVENLİ KİP (kuru prova): boş bırak, yoksa canlı bot webhook'u çalınır.
PUBLIC_URL=
# Şifre sıfırlama bağlantısının web adresi. Örn: https://app.beautyossapp.com
FRONTEND_URL=
# Üretimde zorunlu (yoksa API başlamaz). Virgülle ayrılmış tam adresler.
ALLOWED_ORIGINS=
# Uygulama veritabanı bağlantısı (kısıtlı uygulama rolü). Sunucu adı: postgres
# Örn: postgresql://uygulama_rolu:PAROLA@postgres:5432/beautyos
DATABASE_URL=
# Redis bağlantısı; parola .env.redis'tekiyle aynı. Örn: redis://:PAROLA@redis:6379
REDIS_URL=
# En az 32 karakter. Üretim: openssl rand -hex 32
JWT_SECRET=
# Superadmin tohumlama gizli anahtarı
ADMIN_SEED_SECRET=
# Cloudflare Turnstile gizli anahtarı (üretimde yoksa herkese açık randevu reddedilir)
TURNSTILE_SECRET_KEY=
# Hata takibi (isteğe bağlı)
SENTRY_DSN=
# E-posta (Resend). GÜVENLİ KİP: boş
RESEND_API_KEY=
# Telegram botu. GÜVENLİ KİP: boş
TELEGRAM_BOT_TOKEN=
TELEGRAM_SECRET_TOKEN=
TELEGRAM_TENANT_ID=
# Gemini (bot niyet çözümleme). GÜVENLİ KİP: boş
GEMINI_API_KEY=
# SMS (NetGSM). GÜVENLİ KİP: boş (sahte sağlayıcı kullanılır)
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_HEADER=
SMS_COST_PER_PART=
# WhatsApp (360dialog). Kullanılmıyorsa boş
WHATSAPP_360DIALOG_API_KEY=
WHATSAPP_SANDBOX=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# =====================================================================================
# VERİTABANI (.env.db dosyasına) — yalnız postgres servisi okur; süper kullanıcıdır, uygulama bununla bağlanmaz
# =====================================================================================
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# =====================================================================================
# REDIS (.env.redis dosyasına) — yalnız redis servisi okur
# =====================================================================================
REDIS_PASSWORD=

# =====================================================================================
# MIGRATION (.env.migrate dosyasına) — yalnız tek seferlik migrate servisi okur; api'nin .env'ine YAZILMAZ
# =====================================================================================
# Şema sahibi rolün bağlantısı. Örn: postgresql://migration_rolu:PAROLA@postgres:5432/beautyos
MIGRATION_DATABASE_URL=
