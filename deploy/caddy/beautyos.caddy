# BeautyOS site parçası. Sunucuda /srv/caddy/siteler/beautyos.caddy olarak ortak Caddy'ye import edilir.
# Caddy konteyneri sirket-proxy ağındadır; beautyos-web ve beautyos-api bu ağdaki takma adlardır.
# Kuru prova için yeni.beautyossapp.com geçici olarak ilk satıra eklenir, geçişte çıkarılır.
# X-Forwarded-For'u gerçek istemci IP'siyle yeniden yazmak hız sınırı için şarttır (ADR-0010).

beautyossapp.com, www.beautyossapp.com, app.beautyossapp.com {
	encode zstd gzip

	reverse_proxy beautyos-web:3000 {
		header_up X-Forwarded-For {client_ip}
	}
}

api.beautyossapp.com {
	encode zstd gzip

	# Kimlik doğrulamasız ve her çağrıda ücretli Gemini isteği atan uç nokta (R3); kodda kaldırılana kadar kapalı.
	@debug path /debug /debug/*
	respond @debug 404

	reverse_proxy beautyos-api:3001 {
		header_up X-Forwarded-For {client_ip}
	}
}
